<?xml version="1.0"?>
<launch>
  <node pkg="morai_visualization"
        type="path_visualizer_node"
        name="path_visualizer_under_test"
        output="screen"
        required="true">
    <param name="global_path_topic" value="/test/global_path"/>
    <param name="local_path_topic" value="/test/local_path"/>
    <param name="localization_topic" value="/test/localization_pose"/>
    <param name="marker_topic" value="/test/path_markers"/>
    <param name="frame_id" value="map"/>
    <param name="vehicle_origin_diameter" value="0.3"/>
    <param name="vehicle_origin_label_height" value="0.35"/>
  </node>

  <test test-name="path_visualizer_marker_contract"
        pkg="morai_visualization"
        type="test_path_visualizer.py"
        time-limit="20"/>
</launch>
