<?xml version="1.0"?>
<package format="2">
  <name>morai_visualization</name>
  <version>0.1.0</version>
  <description>Independent RViz profiles and debug markers for the MORAI stack.</description>

  <maintainer email="stier@todo.todo">STIER</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>rviz</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>rospy</test_depend>
  <test_depend>rostest</test_depend>

  <export/>
</package>
