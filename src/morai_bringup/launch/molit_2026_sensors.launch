<?xml version="1.0"?>
<launch>
  <arg name="publish_description" default="true"/>
  <arg name="use_lidar" default="true"/>

  <arg name="bridge_config" default="$(find morai_udp_bridge)/config/molit_2026.yaml"/>
  <arg name="vehicle_config" default="$(find ioniq5_description)/config/vehicle_specs.yaml"/>
  <arg name="sensor_mount_config" default="$(find ioniq5_description)/config/molit_2026_sensor_mounts.yaml"/>

  <arg name="lidar_device_ip" default=""/>
  <arg name="lidar_port" default="2368"/>
  <arg name="lidar_hz" default="15.0"/>
  <arg name="lidar_frame" default="lidar_link"/>
  <arg name="lidar_cut_angle" default="0.0"/>
  <arg name="lidar_fixed_frame" default=""/>
  <arg name="lidar_target_frame" default=""/>
  <arg name="lidar_calibration"
       default="$(find velodyne_pointcloud)/params/VLP16db.yaml"/>

  <group if="$(arg publish_description)">
    <include file="$(find ioniq5_description)/launch/description.launch">
      <arg name="vehicle_config" value="$(arg vehicle_config)"/>
      <arg name="sensor_config" value="$(arg sensor_mount_config)"/>
    </include>
  </group>

  <node pkg="morai_udp_bridge"
        type="morai_udp_bridge_node"
        name="morai_udp_bridge"
        output="screen"
        required="true">
    <rosparam command="load" file="$(arg bridge_config)"/>
    <rosparam command="load" file="$(arg sensor_mount_config)" ns="sensor_setup"/>
  </node>

  <!-- MORAI emits native Velodyne VLP-16 UDP packets. Keep the driver,
       transform and laserscan nodelets explicit so scan cutting and optional
       ego-motion compensation remain configurable from this bringup. -->
  <group if="$(arg use_lidar)">
    <remap from="velodyne_packets" to="/sensors/lidar/packets"/>
    <remap from="velodyne_points" to="/lidar3D"/>
    <remap from="scan" to="/sensors/lidar/scan"/>

    <include file="$(find velodyne_driver)/launch/nodelet_manager.launch">
      <arg name="device_ip" value="$(arg lidar_device_ip)"/>
      <arg name="port" value="$(arg lidar_port)"/>
      <arg name="rpm" value="$(eval float(arg('lidar_hz')) * 60.0)"/>
      <arg name="frame_id" value="$(arg lidar_frame)"/>
      <arg name="model" value="VLP16"/>
      <arg name="manager" value="morai_lidar_nodelet_manager"/>
      <arg name="cut_angle" value="$(arg lidar_cut_angle)"/>
    </include>

    <include file="$(find velodyne_pointcloud)/launch/transform_nodelet.launch">
      <arg name="model" value="VLP16"/>
      <arg name="calibration" value="$(arg lidar_calibration)"/>
      <arg name="manager" value="morai_lidar_nodelet_manager"/>
      <arg name="fixed_frame" value="$(arg lidar_fixed_frame)"/>
      <arg name="target_frame" value="$(arg lidar_target_frame)"/>
      <arg name="min_range" value="0.4"/>
      <arg name="max_range" value="130.0"/>
      <arg name="organize_cloud" value="false"/>
    </include>

    <include file="$(find velodyne_pointcloud)/launch/laserscan_nodelet.launch">
      <arg name="manager" value="morai_lidar_nodelet_manager"/>
      <arg name="ring" value="-1"/>
      <arg name="resolution" value="0.007"/>
    </include>
  </group>
</launch>
