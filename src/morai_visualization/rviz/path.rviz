Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 10
      Class: rviz/Grid
      Color: 90; 90; 90
      Enabled: true
      Name: Map Grid
      Plane: XY
      Plane Cell Count: 200
      Reference Frame: map
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /visualization/path
      Name: Path Visualization
      Namespaces:
        current_position: true
        global_path: true
        global_path_start: true
        local_path: true
        nearest_waypoint: true
        vehicle_heading: true
      Queue Size: 100
      Value: true
    - Alpha: 0.45
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 190; 230
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: Raw Global Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 0; 255; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /global_path
      Value: true
    - Alpha: 0.85
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 110; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.08
      Name: Raw Local Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 170; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /local_path
      Value: true
    - Alpha: 0.65
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Name: IONIQ 5 and Sensors
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
  Enabled: true
  Global Options:
    Background Color: 32; 32; 32
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz/TopDownOrtho
      Name: Top Down
      Near Clip Distance: 0.01
      Scale: 5
      Target Frame: base_link
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
