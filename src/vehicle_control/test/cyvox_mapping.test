<launch>
  <group ns="cyvox_mapping_test">
    <rosparam command="load"
              file="$(find vehicle_control)/config/cyvox_mx.yaml"/>

    <node pkg="vehicle_control"
          type="joystick_teleop_node"
          name="joystick_teleop_node"
          output="screen">
      <param name="joy_topic" value="/test/cyvox/joy"/>
      <param name="command_topic" value="/test/cyvox/command"/>
      <param name="odometry_topic" value="/test/cyvox/odometry"/>
      <param name="odometry_timeout" value="0.15"/>
      <param name="maximum_gear_change_speed_mps" value="0.5"/>
      <param name="initial_gear" value="4"/>
      <param name="drive_button" value="0"/>
      <param name="neutral_button" value="1"/>
      <param name="reverse_button" value="2"/>
      <param name="park_button" value="3"/>
    </node>
  </group>

  <test test-name="cyvox_mapping"
        pkg="vehicle_control"
        type="test_cyvox_mapping.py"
        time-limit="15"/>
</launch>
